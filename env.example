# Copiaza acest fisier in ".env" si completeaza valorile reale.
# Fisierul .env NU trebuie urcat niciodata public (contine parole).

# Portul pe care porneste serverul
PORT=3000

# Autentificare pentru panoul /admin (obligatoriu de setat!)
ADMIN_USER=admin
ADMIN_PASSWORD=schimba-aceasta-parola

# Adresa la care se trimit automat cererile noi (implicit office@echychiatrade.ro)
NOTIFY_EMAIL=office@echychiatrade.ro

# Numarul de WhatsApp folosit pentru linkurile "Trimite pe WhatsApp" (fara +, fara spatii)
WHATSAPP_NUMBER=40724306364

# --- Trimitere automata de email (optional) ---
# Daca lasi aceste campuri necompletate, cererile tot se salveaza si apar in panoul admin,
# doar ca nu se mai trimite automat un email la fiecare cerere noua.
# Exemplu pentru un cont Gmail cu "parola de aplicatie" (App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=numele.tau@gmail.com
#   SMTP_PASS=parola-de-aplicatie-16-caractere
#   SMTP_FROM=numele.tau@gmail.com
# Pentru cont de hosting/cPanel, foloseste datele SMTP oferite de providerul de hosting/email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Webhook optional, pentru Zapier / Make / Google Sheets ---
# Pune aici URL-ul unui "Catch Hook" din Zapier sau Make, sau al unui Google Apps Script
# Web App conectat la un Google Sheet. La fiecare cerere noua, sistemul trimite automat
# un POST cu datele cererii catre acest URL, in format JSON.
WEBHOOK_URL=
