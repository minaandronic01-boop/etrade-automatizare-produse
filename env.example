# Copiaza acest fisier in ".env" si completeaza valorile reale.
# Fisierul .env NU trebuie urcat niciodata public (contine parole).

# Portul pe care porneste serverul
PORT=3000

# Autentificare pentru panoul /admin (obligatoriu de setat!)
ADMIN_USER=admin
ADMIN_PASSWORD=schimba-aceasta-parola

# Adresa la care se trimit automat cererile noi (implicit office@echychiatrade.ro)
NOTIFY_EMAIL=office@echychiatrade.ro

# Numarul de WhatsApp folosit pentru linkurile "Trimite pe WhatsApp" (fara +, fara spatii)
WHATSAPP_NUMBER=40724306364

# --- Trimitere automata de email (optional) ---
# Daca lasi ambele metode de mai jos necompletate, cererile tot se salveaza si apar
# in panoul admin, doar ca nu se mai trimite automat un email la fiecare cerere noua.

# Metoda 1 (RECOMANDATA pentru Render/hosting gratuit): Resend, prin API HTTPS.
# Multe gazde gratuite blocheaza porturile SMTP (25/465/587), dar niciodata HTTPS,
# de-aia Resend functioneaza acolo unde SMTP-ul clasic nu merge (eroare ETIMEDOUT).
# Cont gratuit pe resend.com -> API Keys (genereaza o cheie, incepe cu "re_").
# RESEND_FROM_EMAIL: pana verifici un domeniu propriu in Resend, poti trimite doar
# catre adresa cu care te-ai inregistrat pe Resend (suficient pentru testare).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Metoda 2: Brevo, prin API HTTPS (alternativa la Resend, acelasi principiu).
# Cont gratuit pe brevo.com -> Settings -> SMTP & API -> API Keys (genereaza o cheie).
# BREVO_FROM_EMAIL trebuie sa fie o adresa verificata in Brevo (Settings -> Senders).
# Atentie: conturile Brevo noi pot necesita activare manuala (verificare telefon
# sau contactarea suportului) inainte sa poata trimite emailuri.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Metoda 3: SMTP clasic (foloseste doar daca Metodele 1 si 2 nu sunt configurate).
# Functioneaza local sau pe un hosting/VPS care nu blocheaza porturile SMTP.
# Exemplu pentru un cont Gmail cu "parola de aplicatie" (App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=numele.tau@gmail.com
#   SMTP_PASS=parola-de-aplicatie-16-caractere
#   SMTP_FROM=numele.tau@gmail.com
# Pentru cont de hosting/cPanel, foloseste datele SMTP oferite de providerul de hosting/email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Webhook optional, pentru Zapier / Make / Google Sheets ---
# Pune aici URL-ul unui "Catch Hook" din Zapier sau Make, sau al unui Google Apps Script
# Web App conectat la un Google Sheet. La fiecare cerere noua, sistemul trimite automat
# un POST cu datele cererii catre acest URL, in format JSON.
WEBHOOK_URL=
